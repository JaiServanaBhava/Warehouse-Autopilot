# ==========================================
# WAREHOUSE AUTOPILOT — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to version control.
# ==========================================

# ── Gemini AI ───────────────────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/app/apikey
# The key should start with "AIza..."
GEMINI_API_KEY=AIzaSy_your_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Twilio Email API ────────────────────────────────────────────────────
# Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_EMAIL_API_URL=https://comms.twilio.com/v1/Emails
TWILIO_EMAIL_FROM=ACxxxxxxxx@twilio.email
TWILIO_EMAIL_SENDER_NAME=Warehouse Autopilot

# ── Twilio WhatsApp ─────────────────────────────────────────────────────
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx
TWILIO_WHATSAPP_TO=whatsapp:+91xxxxxxxxxx
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Recipient Emails ────────────────────────────────────────────────────
COMPANY_EMAIL=manager@yourcompany.com
SUPPLIER_PO_RECIPIENT=supplier@procurement.com

# ── Feature Toggles ─────────────────────────────────────────────────────
AUTOMATIC_EMAIL_ENABLED=true
AUTOMATIC_WHATSAPP_ENABLED=true

# ── CORS (comma-separated allowed origins, or * for open access) ─────────
CORS_ORIGINS=*
